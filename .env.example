# Copy this file to .env.local and fill in the values from
# Supabase Dashboard → Project Settings → API Keys (and Data API for the URL).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable key (sb_publishable_...). The legacy "anon" key also works here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Optional: comma-separated sites allowed to show this app in an iframe, e.g.
# a chat widget. Needs https (next dev --experimental-https). See src/lib/embed-origins.ts.
# NEXT_PUBLIC_EMBED_ORIGINS=http://localhost:3000

# Optional: phone notifications for 1:1 chats (README → Phone notifications).
# Generate the key pair with: npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# A long random string. The Supabase Database Webhook sends it in the
# x-push-secret header so only Supabase can trigger /api/push.
# PUSH_WEBHOOK_SECRET=
# Supabase → Project Settings → API Keys → secret key. Server only: never
# give it a NEXT_PUBLIC_ name.
# SUPABASE_SECRET_KEY=
