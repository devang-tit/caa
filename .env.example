# Copy this file to .env.local and fill in the values from
# Supabase Dashboard → Project Settings → API Keys (and Data API for the URL).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable key (sb_publishable_...). The legacy "anon" key also works here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Optional: comma-separated sites allowed to show this app in an iframe, e.g.
# a chat widget. Needs https (next dev --experimental-https). See src/lib/embed-origins.ts.
# NEXT_PUBLIC_EMBED_ORIGINS=http://localhost:3000
